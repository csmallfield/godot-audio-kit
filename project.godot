; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Godot Audio Kit"
config/description="Procedural sound and music for Godot: recipe-based synthesis, deterministic bakes, cue-driven sync with the Godot Motion Kit."
config/features=PackedStringArray("4.7")

[audio]

driver/mix_rate=48000

[autoload]

MotionTransition="*res://addons/motion_kit/game/motion_transition.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/audio_kit/plugin.cfg", "res://addons/motion_kit/plugin.cfg")
