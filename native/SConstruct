#!/usr/bin/env python
# SPDX-License-Identifier: Apache-2.0
# Builds the Audio Kit native core (GDExtension).
#   cd native && scons platform=linux target=template_debug
# Output: addons/audio_kit/native/bin/libaknative.<platform>.<target>.<arch>.<ext>
import os

# A small class profile keeps the godot-cpp build short. Defaults that suit
# DSP: optimise for speed, no debug symbols (override on the command line).
ARGUMENTS.setdefault("build_profile", "build_profile.json")
ARGUMENTS.setdefault("optimize", "speed")
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

out_dir = "../addons/audio_kit/native/bin/"
name = "libaknative{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
if env["platform"] == "macos":
    library = env.SharedLibrary(
        out_dir + "libaknative.{}.{}.framework/libaknative.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]),
        source=sources)
else:
    library = env.SharedLibrary(out_dir + name, source=sources)
Default(library)
