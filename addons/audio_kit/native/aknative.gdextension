[configuration]

entry_symbol = "aknative_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/audio_kit/native/bin/libaknative.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/audio_kit/native/bin/libaknative.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/audio_kit/native/bin/libaknative.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/audio_kit/native/bin/libaknative.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://addons/audio_kit/native/bin/libaknative.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/audio_kit/native/bin/libaknative.windows.template_release.x86_64.dll"
macos.debug = "res://addons/audio_kit/native/bin/libaknative.macos.template_debug.framework"
macos.release = "res://addons/audio_kit/native/bin/libaknative.macos.template_release.framework"
